# Copy this file to server/.env and fill in your real values.
# NEVER commit .env — it is in .gitignore.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitpulse
DB_USER=root
DB_PASSWORD=your_db_password_here

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# ── Client URL (for CORS + password-reset links) ──────────────
CLIENT_URL=http://localhost:5173

# ── SMTP (optional — for password reset emails) ───────────────
# If not set, reset links are printed to the server console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="FitPulse <noreply@fitpulse.app>"
