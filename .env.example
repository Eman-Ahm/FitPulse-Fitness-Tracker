# Copy this file to .env and fill in your real values.
# NEVER commit .env

# Server
PORT=5000
NODE_ENV=development

# Database - use the dedicated app user, not root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitpulse
DB_USER=fitpulse_user
DB_PASSWORD=your_db_password_here

# JWT - use a long random string (run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173
